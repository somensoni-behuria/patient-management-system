# Copy to .env and adjust as needed. docker-compose.yml provides sane local defaults, so this
# file is optional for local runs. Override these in real environments.

# --- Auth / JWT ---
# Base64-encoded HS256 secret, >= 256 bits. Generate: openssl rand -base64 48
JWT_SECRET=ZGV2LW9ubHktc2VjcmV0LXBsZWFzZS1vdmVycmlkZS1pbi1wcm9kLTAxMjM0NTY3ODlBQkNERUY=
JWT_EXPIRATION_MS=36000000
AUTH_SEED_EMAIL=testuser@test.com
AUTH_SEED_PASSWORD=password123

# --- Databases ---
PATIENT_DB_USER=patient
PATIENT_DB_PASSWORD=password
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=password
ANALYTICS_DB_USER=analytics
ANALYTICS_DB_PASSWORD=password

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
